{
  "name": "@barber/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:integrazione": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integrazione.config.mjs --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "azzera": "node --experimental-strip-types prisma/azzera.ts"
  },
  "dependencies": {
    "@barber/shared": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
