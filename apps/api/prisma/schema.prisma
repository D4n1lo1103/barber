// Schema del database dell'installazione di un singolo salone.
// Tutte le date e gli orari sono memorizzati in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Ruolo {
  titolare
  dipendente
  cliente
}

enum Profilo {
  barbiere
  parrucchiere
}

/// Utente dell'installazione: personale (titolare, dipendente) o cliente.
model Utente {
  id                    String    @id @default(uuid()) @db.Uuid
  /// Facoltativa: una scheda cliente creata dal personale può avere solo il
  /// numero WhatsApp. Resta unica quando presente.
  email                 String?   @unique
  passwordHash          String?
  nome                  String
  cognome               String
  numeroWhatsapp        String?
  ruolo                 Ruolo
  /// Il numero si verifica con un codice via WhatsApp (fase 7): fino ad allora
  /// resta non verificato, anche quando l'account è attivo.
  numeroVerificato      Boolean   @default(false)
  /// Note interne del personale sulla scheda cliente.
  note                  String    @default("")
  attivo                Boolean   @default(true)
  emailVerificata       Boolean   @default(false)
  /// Consensi GDPR raccolti alla registrazione, separati: il momento in cui
  /// sono stati dati vale come prova. Nullo significa consenso non dato.
  consensoTrattamentoIl DateTime?
  consensoWhatsappIl    DateTime?
  /// Momento in cui la scheda è stata anonimizzata su richiesta del cliente.
  anonimizzataIl        DateTime?
  creatoIl              DateTime  @default(now())
  aggiornatoIl          DateTime  @updatedAt
  ultimoAccessoIl       DateTime?

  sessioni                  Sessione[]
  serviziAbilitati          ServizioOperatore[]
  orariDiLavoro             OrarioOperatore[]
  assenze                   Assenza[]
  token                     TokenUtente[]
  richiesteCancellazione    RichiestaCancellazione[] @relation("richiesteDelCliente")
  richiesteEvase            RichiestaCancellazione[] @relation("richiesteEvase")
  appuntamentiComeCliente   Appuntamento[]           @relation("appuntamentiDelCliente")
  appuntamentiComeOperatore Appuntamento[]           @relation("appuntamentiDellOperatore")
  appuntamentiCreati        Appuntamento[]           @relation("appuntamentiCreati")
  appuntamentiAnnullati     Appuntamento[]           @relation("appuntamentiAnnullati")
  pagamenti                 Pagamento[]
  movimentiCaparra          MovimentoCaparra[]        @relation("movimentiDelCliente")
  movimentiCaparraRegistrati MovimentoCaparra[]       @relation("movimentiRegistrati")
  movimentiCredito          MovimentoCredito[]        @relation("creditoDelCliente")
  movimentiCreditoRegistrati MovimentoCredito[]       @relation("creditoRegistrato")

  @@index([ruolo, attivo])
  @@map("utenti")
}

/// Sessione di accesso: il cookie contiene solo l'identificativo opaco,
/// mentre nel database è memorizzato l'hash del token di sessione.
model Sessione {
  id           String    @id @default(uuid()) @db.Uuid
  utenteId     String    @db.Uuid
  tokenHash    String    @unique
  csrfHash     String
  creataIl     DateTime  @default(now())
  scadeIl      DateTime
  revocataIl   DateTime?
  indirizzoIp  String?
  agenteUtente String?

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId])
  @@index([scadeIl])
  @@map("sessioni")
}

/// Impostazioni dell'installazione: una sola riga, creata dalla procedura guidata.
/// Il vincolo di riga unica è applicato da una migrazione SQL manuale.
model Installazione {
  id                          String   @id @default(uuid()) @db.Uuid
  /// Vale sempre 1: insieme al vincolo CHECK garantisce una sola installazione.
  riga                        Int      @unique @default(1)
  profilo                     Profilo
  nomeSalone                  String
  indirizzo                   String
  citta                       String
  telefono                    String
  emailSalone                 String
  configurata                 Boolean  @default(false)
  granularitaSlotMin          Int      @default(15)
  /// Ore entro cui un annullamento del cliente è considerato tempestivo.
  oreLimitePreavviso          Int      @default(24)
  /// Se vero lo spostamento segue le regole dell'annullamento; se falso è
  /// libero entro il limite di preavviso.
  spostamentoComeAnnullamento Boolean  @default(false)
  /// Anticipo del promemoria al cliente, in ore (fase 7).
  oreAnticipoPromemoria       Int      @default(24)
  minutiBloccoSlot            Int      @default(10)
  /// Caparra: il salone decide se applicarla e con quale percentuale sul
  /// prezzo dei servizi. Nessun valore cablato nel codice.
  caparraAttiva               Boolean  @default(false)
  caparraPercentuale          Int      @default(50)
  /// Forma di restituzione per un annullamento tempestivo del cliente.
  restituzioneCaparra         FormaRestituzione @default(rimborso)
  /// Messaggi WhatsApp: l'attivazione e i dati non segreti si impostano nella
  /// procedura guidata e dalle impostazioni. Il token resta nell'ambiente.
  whatsappAttivo              Boolean  @default(false)
  /// Identificativo del numero mittente presso Meta: non è un segreto.
  whatsappIdNumero            String   @default("")
  /// Nomi dei modelli approvati da Meta, uno per messaggio di servizio.
  whatsappModelloConferma     String   @default("conferma_prenotazione")
  whatsappModelloPromemoria   String   @default("promemoria_appuntamento")
  whatsappModelloInvito       String   @default("invito_attivazione")
  whatsappModelloVerifica     String   @default("verifica_numero")
  venditaOnlineAttiva         Boolean  @default(false)
  creataIl                    DateTime @default(now())
  aggiornataIl                DateTime @updatedAt

  @@map("installazione")
}

/// Servizio erogato dal salone, con prezzo e durata fissa.
model Servizio {
  nome            String
  id              String   @id @default(uuid()) @db.Uuid
  descrizione     String   @default("")
  /// Prezzo in centesimi di euro, IVA inclusa.
  prezzoCentesimi Int
  durataMinuti    Int
  attivo          Boolean  @default(true)
  ordine          Int      @default(0)
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  operatoriAbilitati ServizioOperatore[]
  negliAppuntamenti  AppuntamentoServizio[]

  @@unique([nome])
  @@index([attivo, ordine])
  @@map("servizi")
}

/// Tipo di assenza di un operatore.
enum TipoAssenza {
  ferie
  riposo
  /// Chiusura straordinaria del salone: registrata per tutti gli operatori
  /// dall'unico flusso delle chiusure.
  chiusura
  altro
}

/// Abilitazione di un operatore a erogare un servizio.
model ServizioOperatore {
  servizioId  String @db.Uuid
  operatoreId String @db.Uuid

  servizio  Servizio @relation(fields: [servizioId], references: [id], onDelete: Cascade)
  operatore Utente   @relation(fields: [operatoreId], references: [id], onDelete: Cascade)

  @@id([servizioId, operatoreId])
  @@index([operatoreId])
  @@map("servizi_operatori")
}

/// Fascia di apertura del salone in un giorno della settimana.
/// Gli orari sono minuti dalla mezzanotte nel fuso del salone (Europe/Rome),
/// non istanti: valgono ogni settimana, anche nei giorni di cambio dell'ora legale.
model OrarioApertura {
  id              String   @id @default(uuid()) @db.Uuid
  /// 1 = lunedì … 7 = domenica (ISO-8601).
  giornoSettimana Int
  minutoInizio    Int
  minutoFine      Int
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  @@index([giornoSettimana])
  @@map("orari_apertura")
}

/// Fascia di lavoro di un operatore in un giorno della settimana.
model OrarioOperatore {
  id              String   @id @default(uuid()) @db.Uuid
  operatoreId     String   @db.Uuid
  /// 1 = lunedì … 7 = domenica (ISO-8601).
  giornoSettimana Int
  minutoInizio    Int
  minutoFine      Int
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  operatore Utente @relation(fields: [operatoreId], references: [id], onDelete: Cascade)

  @@index([operatoreId, giornoSettimana])
  @@map("orari_operatori")
}

/// Assenza di un operatore: ferie, giorno di riposo o altra indisponibilità.
/// Le date sono istanti in UTC; l'intervallo comprende l'inizio ed esclude la fine.
model Assenza {
  id           String      @id @default(uuid()) @db.Uuid
  operatoreId  String      @db.Uuid
  tipo         TipoAssenza
  inizio       DateTime
  fine         DateTime
  note         String      @default("")
  creataIl     DateTime    @default(now())
  aggiornataIl DateTime    @updatedAt

  operatore Utente @relation(fields: [operatoreId], references: [id], onDelete: Cascade)

  @@index([operatoreId, inizio])
  @@map("assenze")
}

/// Scopo di un token a uso singolo inviato all'utente.
enum TipoToken {
  /// Attivazione dell'account e scelta della password (dipendenti e clienti
  /// con scheda creata dal personale).
  attivazione
  /// Verifica dell'indirizzo e-mail dopo la registrazione autonoma.
  verifica_email
  /// Reimpostazione della password dimenticata.
  reset_password
  /// Codice numerico inviato via WhatsApp per verificare il numero.
  verifica_numero
}

/// Token a uso singolo inviato per e-mail. Nel database è memorizzato solo
/// l'hash: il valore in chiaro esiste solo nel link consegnato all'utente.
model TokenUtente {
  id        String    @id @default(uuid()) @db.Uuid
  utenteId  String    @db.Uuid
  tipo      TipoToken @default(attivazione)
  tokenHash String    @unique
  scadeIl   DateTime
  usatoIl   DateTime?
  creatoIl  DateTime  @default(now())

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, tipo])
  @@map("token_utente")
}

/// Stato della richiesta di cancellazione dei dati (GDPR).
enum StatoRichiestaCancellazione {
  in_attesa
  evasa
  rifiutata
}

/// Richiesta del cliente di cancellare i propri dati. La evade il titolare:
/// i dati personali vengono rimossi e lo storico resta in forma anonima.
model RichiestaCancellazione {
  id           String                      @id @default(uuid()) @db.Uuid
  clienteId    String                      @db.Uuid
  stato        StatoRichiestaCancellazione @default(in_attesa)
  /// Motivo indicato dal cliente, facoltativo.
  motivo       String                      @default("")
  /// Nota del titolare quando evade o rifiuta la richiesta.
  notaTitolare String                      @default("")
  richiestaIl  DateTime                    @default(now())
  evasaIl      DateTime?
  evasaDaId    String?                     @db.Uuid

  cliente Utente  @relation("richiesteDelCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  evasaDa Utente? @relation("richiesteEvase", fields: [evasaDaId], references: [id], onDelete: SetNull)

  @@index([stato, richiestaIl])
  @@index([clienteId])
  @@map("richieste_cancellazione")
}

enum StatoAppuntamento {
  in_attesa_pagamento
  confermato
  completato
  annullato
  mancata_presentazione
}

enum MotivoAnnullamento {
  tempestivo
  tardivo
  dal_salone
  pagamento_non_completato
}

/// Appuntamento di un cliente con un operatore, per uno o più servizi erogati
/// uno dopo l'altro. `inizio` e `fine` sono istanti in UTC: l'intervallo
/// comprende l'inizio ed esclude la fine. Una migrazione SQL manuale impedisce
/// con un vincolo di esclusione che due appuntamenti dello stesso operatore si
/// sovrappongano.
model Appuntamento {
  id                    String              @id @default(uuid()) @db.Uuid
  clienteId             String              @db.Uuid
  operatoreId           String              @db.Uuid
  inizio                DateTime
  fine                  DateTime
  /// Somma delle durate dei servizi scelti, copiata alla prenotazione.
  durataMinuti          Int
  /// Somma dei prezzi dei servizi scelti, copiata alla prenotazione.
  prezzoTotaleCentesimi Int
  stato                 StatoAppuntamento
  motivoAnnullamento    MotivoAnnullamento?
  /// Dettaglio registrato dal personale quando annulla.
  noteAnnullamento      String              @default("")
  /// Appuntamento inserito dal personale senza richiedere la caparra.
  senzaCaparra          Boolean             @default(false)
  /// Caparra dovuta, calcolata alla prenotazione sulla percentuale di allora:
  /// un cambio di impostazione non altera gli appuntamenti già fissati.
  /// Zero quando la caparra non è richiesta.
  caparraCentesimi      Int                 @default(0)
  /// Scadenza del blocco dello slot durante il pagamento: oltre questo
  /// istante un appuntamento ancora `in_attesa_pagamento` viene annullato.
  bloccoScadeIl         DateTime?
  /// Momento in cui è stato inviato il promemoria: evita di inviarlo due
  /// volte quando l'attività periodica ripassa.
  promemoriaInviatoIl   DateTime?
  note                  String              @default("")
  /// Operatore o dipendente che ha inserito l'appuntamento; nullo quando ha
  /// prenotato il cliente stesso dall'area clienti.
  creatoDaId            String?             @db.Uuid
  annullatoDaId         String?             @db.Uuid
  annullatoIl           DateTime?
  completatoIl          DateTime?
  creatoIl              DateTime            @default(now())
  aggiornatoIl          DateTime            @updatedAt

  cliente     Utente  @relation("appuntamentiDelCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  operatore   Utente  @relation("appuntamentiDellOperatore", fields: [operatoreId], references: [id], onDelete: Restrict)
  creatoDa    Utente? @relation("appuntamentiCreati", fields: [creatoDaId], references: [id], onDelete: SetNull)
  annullatoDa Utente? @relation("appuntamentiAnnullati", fields: [annullatoDaId], references: [id], onDelete: SetNull)

  servizi            AppuntamentoServizio[]
  pagamenti          Pagamento[]
  movimentiCaparra   MovimentoCaparra[]
  movimentiCredito   MovimentoCredito[]

  @@index([operatoreId, inizio])
  @@index([clienteId, inizio])
  @@index([stato, inizio])
  @@map("appuntamenti")
}

/// Servizio incluso in un appuntamento. Nome, prezzo e durata sono copiati al
/// momento della prenotazione: un cambio di listino non altera gli
/// appuntamenti già fissati né lo storico del cliente.
model AppuntamentoServizio {
  id              String  @id @default(uuid()) @db.Uuid
  appuntamentoId  String  @db.Uuid
  /// Nullo se il servizio viene eliminato dal catalogo.
  servizioId      String? @db.Uuid
  nome            String
  prezzoCentesimi Int
  durataMinuti    Int
  ordine          Int     @default(0)

  appuntamento Appuntamento @relation(fields: [appuntamentoId], references: [id], onDelete: Cascade)
  servizio     Servizio?    @relation(fields: [servizioId], references: [id], onDelete: SetNull)

  @@index([appuntamentoId, ordine])
  @@index([servizioId])
  @@map("appuntamenti_servizi")
}

/// Forma con cui il salone restituisce una caparra: rimborso sul metodo di
/// pagamento oppure credito a favore del cliente.
enum FormaRestituzione {
  rimborso
  credito
}

/// Stato di un pagamento presso il fornitore esterno. Diventa definitivo solo
/// con la conferma via webhook.
enum StatoPagamento {
  /// Creato presso il fornitore, in attesa che il cliente paghi.
  avviato
  riuscito
  fallito
  /// Scaduto o abbandonato prima del pagamento.
  annullato
  rimborsato
}

/// Pagamento della caparra presso il fornitore esterno (Stripe). Nessun dato
/// di carta transita né viene memorizzato: resta solo il riferimento opaco
/// all'operazione presso il fornitore.
model Pagamento {
  id               String         @id @default(uuid()) @db.Uuid
  appuntamentoId   String         @db.Uuid
  clienteId        String         @db.Uuid
  importoCentesimi Int
  stato            StatoPagamento @default(avviato)
  /// Identificativo dell'operazione presso il fornitore (es. PaymentIntent).
  riferimento      String         @unique
  /// Identificativo del rimborso presso il fornitore, quando emesso.
  riferimentoRimborso String?
  /// Motivo dell'ultimo esito negativo, per il supporto al cliente.
  erroreFornitore  String         @default("")
  creatoIl         DateTime       @default(now())
  aggiornatoIl     DateTime       @updatedAt

  appuntamento Appuntamento @relation(fields: [appuntamentoId], references: [id], onDelete: Cascade)
  cliente      Utente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([appuntamentoId])
  @@index([clienteId])
  @@index([stato])
  @@map("pagamenti")
}

/// Tipo di movimento della caparra: ogni passaggio di denaro o di diritto
/// sulla caparra lascia una riga, come richiede l'audit.
enum TipoMovimentoCaparra {
  pagata
  rimborsata
  convertita_in_credito
  trattenuta
  /// Scalata dal totale a servizio concluso.
  scalata
  /// Restituita dal titolare in via discrezionale, con motivazione.
  restituita_discrezionale
}

/// Movimento della caparra di un appuntamento: data, importo, autore e motivo.
/// Le righe non si modificano né si cancellano: sono il registro di audit.
model MovimentoCaparra {
  id               String               @id @default(uuid()) @db.Uuid
  appuntamentoId   String               @db.Uuid
  clienteId        String               @db.Uuid
  tipo             TipoMovimentoCaparra
  importoCentesimi Int
  /// Motivo: obbligatorio per la restituzione discrezionale.
  motivo           String               @default("")
  /// Chi ha registrato il movimento; nullo quando l'ha prodotto il sistema
  /// (pagamento confermato dal webhook, scadenza del blocco).
  autoreId         String?              @db.Uuid
  creatoIl         DateTime             @default(now())

  appuntamento Appuntamento @relation(fields: [appuntamentoId], references: [id], onDelete: Cascade)
  cliente      Utente       @relation("movimentiDelCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autore       Utente?      @relation("movimentiRegistrati", fields: [autoreId], references: [id], onDelete: SetNull)

  @@index([appuntamentoId, creatoIl])
  @@index([clienteId, creatoIl])
  @@map("movimenti_caparra")
}

/// Movimento del credito del cliente: positivo quando il credito aumenta,
/// negativo quando viene speso. Il saldo è la somma dei movimenti e non ha
/// scadenza.
model MovimentoCredito {
  id               String   @id @default(uuid()) @db.Uuid
  clienteId        String   @db.Uuid
  /// Positivo in accredito, negativo in utilizzo.
  importoCentesimi Int
  motivo           String   @default("")
  /// Appuntamento che ha generato o speso il credito, quando pertinente.
  appuntamentoId   String?  @db.Uuid
  autoreId         String?  @db.Uuid
  creatoIl         DateTime @default(now())

  cliente      Utente        @relation("creditoDelCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  appuntamento Appuntamento? @relation(fields: [appuntamentoId], references: [id], onDelete: SetNull)
  autore       Utente?       @relation("creditoRegistrato", fields: [autoreId], references: [id], onDelete: SetNull)

  @@index([clienteId, creatoIl])
  @@index([appuntamentoId])
  @@map("movimenti_credito")
}

/// Evento ricevuto dal fornitore di pagamenti, registrato per garantire
/// l'idempotenza: un evento già elaborato viene riconosciuto e ignorato.
model EventoPagamento {
  /// Identificativo dell'evento presso il fornitore.
  id          String    @id
  tipo        String
  ricevutoIl  DateTime  @default(now())
  elaboratoIl DateTime?
  /// Esito dell'elaborazione, per il troubleshooting.
  esito       String    @default("")

  @@index([ricevutoIl])
  @@map("eventi_pagamento")
}
