// Schema del database dell'installazione di un singolo salone.
// Tutte le date e gli orari sono memorizzati in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Ruolo {
  titolare
  dipendente
  cliente
}

enum Profilo {
  barbiere
  parrucchiere
}

/// Utente dell'installazione: personale (titolare, dipendente) o cliente.
model Utente {
  id              String    @id @default(uuid()) @db.Uuid
  /// Facoltativa: una scheda cliente creata dal personale può avere solo il
  /// numero WhatsApp. Resta unica quando presente.
  email           String?   @unique
  passwordHash    String?
  nome            String
  cognome         String
  numeroWhatsapp  String?
  ruolo           Ruolo
  /// Note interne del personale sulla scheda cliente.
  note            String    @default("")
  attivo          Boolean   @default(true)
  emailVerificata Boolean   @default(false)
  creatoIl        DateTime  @default(now())
  aggiornatoIl    DateTime  @updatedAt
  ultimoAccessoIl DateTime?

  sessioni                  Sessione[]
  serviziAbilitati          ServizioOperatore[]
  orariDiLavoro             OrarioOperatore[]
  assenze                   Assenza[]
  invitiAttivazione         InvitoAttivazione[]
  appuntamentiComeCliente   Appuntamento[]      @relation("appuntamentiDelCliente")
  appuntamentiComeOperatore Appuntamento[]      @relation("appuntamentiDellOperatore")
  appuntamentiCreati        Appuntamento[]      @relation("appuntamentiCreati")
  appuntamentiAnnullati     Appuntamento[]      @relation("appuntamentiAnnullati")

  @@index([ruolo, attivo])
  @@map("utenti")
}

/// Sessione di accesso: il cookie contiene solo l'identificativo opaco,
/// mentre nel database è memorizzato l'hash del token di sessione.
model Sessione {
  id           String    @id @default(uuid()) @db.Uuid
  utenteId     String    @db.Uuid
  tokenHash    String    @unique
  csrfHash     String
  creataIl     DateTime  @default(now())
  scadeIl      DateTime
  revocataIl   DateTime?
  indirizzoIp  String?
  agenteUtente String?

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId])
  @@index([scadeIl])
  @@map("sessioni")
}

/// Impostazioni dell'installazione: una sola riga, creata dalla procedura guidata.
/// Il vincolo di riga unica è applicato da una migrazione SQL manuale.
model Installazione {
  id                  String   @id @default(uuid()) @db.Uuid
  /// Vale sempre 1: insieme al vincolo CHECK garantisce una sola installazione.
  riga                Int      @unique @default(1)
  profilo             Profilo
  nomeSalone          String
  indirizzo           String
  citta               String
  telefono            String
  emailSalone         String
  configurata         Boolean  @default(false)
  granularitaSlotMin  Int      @default(15)
  minutiBloccoSlot    Int      @default(10)
  venditaOnlineAttiva Boolean  @default(false)
  creataIl            DateTime @default(now())
  aggiornataIl        DateTime @updatedAt

  @@map("installazione")
}

/// Servizio erogato dal salone, con prezzo e durata fissa.
model Servizio {
  nome            String
  id              String   @id @default(uuid()) @db.Uuid
  descrizione     String   @default("")
  /// Prezzo in centesimi di euro, IVA inclusa.
  prezzoCentesimi Int
  durataMinuti    Int
  attivo          Boolean  @default(true)
  ordine          Int      @default(0)
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  operatoriAbilitati ServizioOperatore[]
  negliAppuntamenti  AppuntamentoServizio[]

  @@unique([nome])
  @@index([attivo, ordine])
  @@map("servizi")
}

/// Tipo di assenza di un operatore.
enum TipoAssenza {
  ferie
  riposo
  altro
}

/// Abilitazione di un operatore a erogare un servizio.
model ServizioOperatore {
  servizioId  String @db.Uuid
  operatoreId String @db.Uuid

  servizio  Servizio @relation(fields: [servizioId], references: [id], onDelete: Cascade)
  operatore Utente   @relation(fields: [operatoreId], references: [id], onDelete: Cascade)

  @@id([servizioId, operatoreId])
  @@index([operatoreId])
  @@map("servizi_operatori")
}

/// Fascia di apertura del salone in un giorno della settimana.
/// Gli orari sono minuti dalla mezzanotte nel fuso del salone (Europe/Rome),
/// non istanti: valgono ogni settimana, anche nei giorni di cambio dell'ora legale.
model OrarioApertura {
  id              String   @id @default(uuid()) @db.Uuid
  /// 1 = lunedì … 7 = domenica (ISO-8601).
  giornoSettimana Int
  minutoInizio    Int
  minutoFine      Int
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  @@index([giornoSettimana])
  @@map("orari_apertura")
}

/// Fascia di lavoro di un operatore in un giorno della settimana.
model OrarioOperatore {
  id              String   @id @default(uuid()) @db.Uuid
  operatoreId     String   @db.Uuid
  /// 1 = lunedì … 7 = domenica (ISO-8601).
  giornoSettimana Int
  minutoInizio    Int
  minutoFine      Int
  creatoIl        DateTime @default(now())
  aggiornatoIl    DateTime @updatedAt

  operatore Utente @relation(fields: [operatoreId], references: [id], onDelete: Cascade)

  @@index([operatoreId, giornoSettimana])
  @@map("orari_operatori")
}

/// Assenza di un operatore: ferie, giorno di riposo o altra indisponibilità.
/// Le date sono istanti in UTC; l'intervallo comprende l'inizio ed esclude la fine.
model Assenza {
  id           String      @id @default(uuid()) @db.Uuid
  operatoreId  String      @db.Uuid
  tipo         TipoAssenza
  inizio       DateTime
  fine         DateTime
  note         String      @default("")
  creataIl     DateTime    @default(now())
  aggiornataIl DateTime    @updatedAt

  operatore Utente @relation(fields: [operatoreId], references: [id], onDelete: Cascade)

  @@index([operatoreId, inizio])
  @@map("assenze")
}

/// Invito con cui un membro del personale attiva il proprio account e sceglie
/// la password. Nel database è memorizzato solo l'hash del token.
model InvitoAttivazione {
  id        String    @id @default(uuid()) @db.Uuid
  utenteId  String    @db.Uuid
  tokenHash String    @unique
  scadeIl   DateTime
  usatoIl   DateTime?
  creatoIl  DateTime  @default(now())

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId])
  @@map("inviti_attivazione")
}

enum StatoAppuntamento {
  in_attesa_pagamento
  confermato
  completato
  annullato
  mancata_presentazione
}

enum MotivoAnnullamento {
  tempestivo
  tardivo
  dal_salone
  pagamento_non_completato
}

/// Appuntamento di un cliente con un operatore, per uno o più servizi erogati
/// uno dopo l'altro. `inizio` e `fine` sono istanti in UTC: l'intervallo
/// comprende l'inizio ed esclude la fine. Una migrazione SQL manuale impedisce
/// con un vincolo di esclusione che due appuntamenti dello stesso operatore si
/// sovrappongano.
model Appuntamento {
  id                    String              @id @default(uuid()) @db.Uuid
  clienteId             String              @db.Uuid
  operatoreId           String              @db.Uuid
  inizio                DateTime
  fine                  DateTime
  /// Somma delle durate dei servizi scelti, copiata alla prenotazione.
  durataMinuti          Int
  /// Somma dei prezzi dei servizi scelti, copiata alla prenotazione.
  prezzoTotaleCentesimi Int
  stato                 StatoAppuntamento
  motivoAnnullamento    MotivoAnnullamento?
  /// Dettaglio registrato dal personale quando annulla.
  noteAnnullamento      String              @default("")
  /// Appuntamento inserito dal personale senza richiedere la caparra.
  senzaCaparra          Boolean             @default(false)
  note                  String              @default("")
  /// Operatore o dipendente che ha inserito l'appuntamento; nullo quando ha
  /// prenotato il cliente stesso dall'area clienti.
  creatoDaId            String?             @db.Uuid
  annullatoDaId         String?             @db.Uuid
  annullatoIl           DateTime?
  completatoIl          DateTime?
  creatoIl              DateTime            @default(now())
  aggiornatoIl          DateTime            @updatedAt

  cliente     Utente  @relation("appuntamentiDelCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  operatore   Utente  @relation("appuntamentiDellOperatore", fields: [operatoreId], references: [id], onDelete: Restrict)
  creatoDa    Utente? @relation("appuntamentiCreati", fields: [creatoDaId], references: [id], onDelete: SetNull)
  annullatoDa Utente? @relation("appuntamentiAnnullati", fields: [annullatoDaId], references: [id], onDelete: SetNull)

  servizi AppuntamentoServizio[]

  @@index([operatoreId, inizio])
  @@index([clienteId, inizio])
  @@index([stato, inizio])
  @@map("appuntamenti")
}

/// Servizio incluso in un appuntamento. Nome, prezzo e durata sono copiati al
/// momento della prenotazione: un cambio di listino non altera gli
/// appuntamenti già fissati né lo storico del cliente.
model AppuntamentoServizio {
  id              String  @id @default(uuid()) @db.Uuid
  appuntamentoId  String  @db.Uuid
  /// Nullo se il servizio viene eliminato dal catalogo.
  servizioId      String? @db.Uuid
  nome            String
  prezzoCentesimi Int
  durataMinuti    Int
  ordine          Int     @default(0)

  appuntamento Appuntamento @relation(fields: [appuntamentoId], references: [id], onDelete: Cascade)
  servizio     Servizio?    @relation(fields: [servizioId], references: [id], onDelete: SetNull)

  @@index([appuntamentoId, ordine])
  @@index([servizioId])
  @@map("appuntamenti_servizi")
}
