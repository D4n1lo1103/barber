# ─── Database ──────────────────────────────────────────────────────────────────
# Obbligatoria. Stringa di connessione PostgreSQL.
DATABASE_URL="postgresql://barber:barber@localhost:5432/barber?schema=public"

# ─── API ───────────────────────────────────────────────────────────────────────
# Obbligatorie.
NODE_ENV="development"
PORTA="3000"
# Segreto per la firma dei cookie e dei token: almeno 32 caratteri casuali.
# Generalo con: openssl rand -base64 48
SEGRETO_SESSIONE="cambiami-con-almeno-trentadue-caratteri-casuali"
# Chiave richiesta per completare la procedura guidata al primo avvio.
# Almeno 16 caratteri casuali, consegnata solo a chi installa il salone.
# Generala con: openssl rand -hex 24
CHIAVE_INSTALLAZIONE="cambiami-chiave-di-installazione"

# Origine del frontend, usata per CORS e per il controllo anti-CSRF.
ORIGINE_WEB="http://localhost:5180"
# Durata della sessione di accesso, in ore.
DURATA_SESSIONE_ORE="12"
# Identificativo dell'installazione (salone), inviato con gli eventi di Sentry.
IDENTIFICATIVO_INSTALLAZIONE="locale"

# Solo per i test automatici: "true" disattiva i limiti di frequenza.
# Il valore è ignorato quando NODE_ENV vale "production".
LIMITI_FREQUENZA_DISATTIVI="false"

# Database temporaneo usato da Prisma per calcolare le migrazioni in sviluppo.
DATABASE_URL_OMBRA="postgresql://barber:barber@localhost:5432/barber_ombra?schema=public"

# Profilo e password degli account dei dati demo (solo sviluppo e staging).
PROFILO_DEMO="barbiere"
PASSWORD_DEMO="password-demo-salone"

# ─── E-mail ────────────────────────────────────────────────────────────────────
# Facoltative in sviluppo: senza SMTP_HOST i messaggi non vengono inviati, ma
# solo registrati nei log del server (il link di verifica resta leggibile lì).
# In produzione sono obbligatorie: provider consigliato Brevo.
SMTP_HOST=""
SMTP_PORTA="587"
SMTP_UTENTE=""
SMTP_PASSWORD=""
# Mittente dei messaggi di servizio.
SMTP_MITTENTE="Gestionale salone <no-reply@localhost>"
# "true" solo con TLS implicito (porta 465).
SMTP_TLS_IMPLICITO="false"

# ─── Attività in background ────────────────────────────────────────────────────
# Coda pg-boss: con "false" le attività (invio e-mail, promemoria) vengono
# eseguite subito, in linea. I test automatici la disattivano.
CODA_ATTIVA="true"

# ─── Monitoraggio (facoltativo) ────────────────────────────────────────────────
SENTRY_DSN=""

# ─── Frontend ──────────────────────────────────────────────────────────────────
# URL pubblico dell'API usato dal browser.
VITE_URL_API="http://localhost:3000/api"
